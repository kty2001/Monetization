# clawler/config.py의 CrawlConfig.from_env()가 읽는 환경변수.
# 이 파일을 .env로 복사해 필요한 값만 채운다 (비워두면 기본값 사용).

# 요청 시 User-Agent 헤더. 비워두면 config.py의 DEFAULT_USER_AGENT(데스크톱 Chrome UA) 사용
MUNPIA_USER_AGENT=

# 요청 간 지연 시간(초). 기본 1.2
MUNPIA_REQUEST_DELAY_SECONDS=1.2

# 5xx/타임아웃 시 최대 재시도 횟수. 기본 3
MUNPIA_MAX_RETRIES=3

# 요청 타임아웃(초). 기본 10
MUNPIA_TIMEOUT_SECONDS=10
